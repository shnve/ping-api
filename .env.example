# Plantilla de Variables de Entorno - PISAC Backend (ping-api)
# Copie este archivo a .env y ajuste los valores segun su entorno (NO suba .env a Git)
PING_PORTAL_URL=http://localhost:4200
PING_SERVICES_URL=http://localhost:8180
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ping-api
POSTGRES_USER=ping-api
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ping-api
GEOSERVER_URL=http://localhost:8082/geoserver
GEOSERVER_USER=CHANGE_ME
GEOSERVER_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_PUBLIC_ADMIN_SECRET=CHANGE_ME
KEYCLOAK_PUBLIC_API_SECRET=CHANGE_ME
KEYCLOAK_PRO_ADMIN_SECRET=CHANGE_ME
KEYCLOAK_PRO_API_SECRET=CHANGE_ME
KEYSTORE_PASSWORD=CHANGE_ME