    <changeSet id="DB.Schemes.0.18.0-Tag" author="a662829">
        <createTable tableName="tag">
            <column name="id" type="${id.type}">
                <constraints primaryKey="true"/>
            </column>
            <column name="value" type="${varchar2.255.type}">
                <constraints nullable="false"/>
            </column>
            <column name="maritime_service_id" type="${id.type}">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
            columnNames="value, maritime_service_id"
            constraintName="tag_unique_constraint"
            tableName="tag"
        />
    </changeSet>

    <changeSet id="DB.Schemes.0.18.0-InfosourceTag" author="a662829">
