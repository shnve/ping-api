            <column name="summary" type="${clob.type}"/>
            <column name="international_summary" type="${clob.type}"/>
            <column name="is_temporary" type="${boolean.type}" defaultValue="false"/>
            <column name="has_coastline_limit" type="${boolean.type}" defaultValue="false"/>
            <column name="is_public" type="${boolean.type}" defaultValue="false"/>
