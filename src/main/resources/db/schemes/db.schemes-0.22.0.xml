            <column name="title" type="${varchar2.255.type}">
                <constraints nullable="false"/>
            </column>
            <column name="read" type="${boolean.type}" defaultValue="false"/>
            <column name="creation_date" type="${timestamp.type}" defaultValueComputed="${now}">
                <constraints nullable="false" />
            </column>
            <column name="read_date" type="${timestamp.type}"/>
