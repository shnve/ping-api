    <changeSet id="DB.Schemes.0.22.0-Subscription" author="w118853">
        <createTable tableName="subscription">
            <column name="id" type="${id.type}">
                <constraints primaryKey="true"/>
            </column>
            <column name="area_id" type="${id.type}">
                <constraints nullable="false"/>
            </column>
            <column name="creation_date" type="${timestamp.type}">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="${varchar2.255.type}">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="${varchar2.255.type}">
                <constraints nullable="false"/>
            </column>
            <column name="sending_mail" type="${boolean.type}" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
            <column name="service_id" type="${id.type}">
                <constraints nullable="true"/>
            </column>
            <column name="public_user_id" type="${id.type}">
                <constraints nullable="true"/>
            </column>
            <column name="lang" type="${varchar2.255.type}">
                <constraints nullable="true"/>
            </column>
            <column name="serie_id" type="${id.type}">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="subscription"
            baseColumnNames="area_id"
            constraintName="subscription_area_id_fk_constraint"
            referencedTableName="area"
            referencedColumnNames="id"
        />

        <addForeignKeyConstraint
            baseTableName="subscription"
            baseColumnNames="service_id"
            constraintName="subscription_service_id_fk_constraint"
            referencedTableName="maritime_service"
            referencedColumnNames="id"
        />

        <addForeignKeyConstraint
            baseTableName="subscription"
            baseColumnNames="public_user_id"
            constraintName="subscription_public_user_id_fk_constraint"
            referencedTableName="public_user"
            referencedColumnNames="id"
        />

        <addForeignKeyConstraint
            baseTableName="subscription"
            baseColumnNames="serie_id"
            constraintName="subscription_serie_id_fk_constraint"
            referencedTableName="serie"
            referencedColumnNames="id"
        />
    </changeSet>

